{
  "headers": [
    {
      "source": "/legale",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/legale/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://next-sphere-connect.replit.app/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
